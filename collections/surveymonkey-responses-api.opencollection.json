{
  "opencollection": "1.0.0",
  "info": {
    "name": "SurveyMonkey API v3 Collectors Responses API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.surveymonkey.com/oauth/authorize",
      "accessTokenUrl": "https://api.surveymonkey.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Responses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List survey responses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.surveymonkey.com/v3/surveys/:survey_id/responses",
            "params": [
              {
                "name": "survey_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List survey responses"
        },
        {
          "info": {
            "name": "Retrieve bulk responses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.surveymonkey.com/v3/surveys/:survey_id/responses/bulk",
            "params": [
              {
                "name": "survey_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve bulk responses"
        },
        {
          "info": {
            "name": "Response counts (rollups)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.surveymonkey.com/v3/surveys/:survey_id/rollups",
            "params": [
              {
                "name": "survey_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Response counts (rollups)"
        },
        {
          "info": {
            "name": "Response trends",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.surveymonkey.com/v3/surveys/:survey_id/trends",
            "params": [
              {
                "name": "survey_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Response trends"
        }
      ]
    }
  ],
  "bundled": true
}